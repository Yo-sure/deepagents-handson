{
  "name": "deepagents-handson-book",
  "version": "2026.06.0",
  "private": true,
  "type": "module",
  "description": "AI Agent 개발 교재 — 인터랙티브 HTML 북 (VitePress)",
  "scripts": {
    "preassets": "python3 ../scripts/package-workshop.py && node scripts/copy-assets.mjs && node scripts/build-chapters.mjs",
